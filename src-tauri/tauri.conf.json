{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skyward Installer",
  "version": "../package.json",
  "identifier": "com.skyward.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Skyward Installer",
        "width": 900,
        "height": 650,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://mdm-backend-i4b0.onrender.com/api/desktop/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxMjRDRTNFMTIwMjU4OTcKUldTWFdBSVNQczRra2FNakxuVTl2S1N1aWhNcUp0MFpBTHNjSUUycDlMY1dyZCswbmJZWU1ZTEMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {}
  }
}